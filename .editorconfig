root = true

# Keep authored C# and project files consistent across IDEs.
[*.{cs,xaml,xml,csproj,json,md}]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.cs]
csharp_new_line_before_open_brace = all
csharp_prefer_braces = true:suggestion
dotnet_sort_system_directives_first = true

# Generated glyph names follow their source font, rather than application naming rules.
[Resources/Fonts/FluentUI.cs]
generated_code = true
